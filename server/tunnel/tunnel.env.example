# Configuración del túnel y del bot de Telegram de ColonyMAXAI.
# Copiar a /etc/colonymaxai/tunnel.env y dejarlo legible sólo por root:
#   sudo install -m 600 -o root -g root tunnel.env.example /etc/colonymaxai/tunnel.env

# Token del bot (lo da @BotFather al crear el bot). Es secreto: no compartirlo.
TELEGRAM_TOKEN=

# Chats donde se avisa la dirección, separados por comas (los grupos empiezan con -).
# Si se deja vacío, el bot contesta a cualquier mensaje con el id de ese chat.
TELEGRAM_CHAT_ID=

# Puerto local del juego (el servidor del juego escucha en 127.0.0.1:3100).
TUNNEL_PORT=3100

# Nombre que aparece en los avisos.
GAME_NAME=ColonyMAXAI
