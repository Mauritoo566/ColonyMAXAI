# Configuración del servidor del juego ColonyMAXAI.
# Copiar a /etc/colonymaxai/game.env:
#   sudo install -m 644 -o root -g root game.env.example /etc/colonymaxai/game.env

# Dónde escucha (sólo local: lo publica el túnel de Cloudflare). El túnel apunta aquí.
HOST=127.0.0.1
PORT=3100

# Base de datos (la carpeta la crea systemd con StateDirectory=colonymaxai).
DB_PATH=/var/lib/colonymaxai/game.db
BACKUP_DIR=/var/lib/colonymaxai/backups
